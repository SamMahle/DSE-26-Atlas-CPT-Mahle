# Standard base parameters for the 5" X quad bench.
# Anything you want to compare goes in bench.json "configs", NOT here.
# Changing this file changes the baseline (its hash is recorded in every run.json).

# --- airframe: 5" X, 6S ---
FRAME_CLASS      1
FRAME_TYPE       1
MOT_THST_EXPO    0.49
MOT_THST_HOVER   0.20
INS_GYRO_FILTER  80
MOT_BAT_VOLT_MAX 25.2
MOT_BAT_VOLT_MIN 19.8
BATT_CAPACITY    1300
SIM_BATT_VOLTAGE 25.2
SIM_BATT_CAP_AH  1.3

# --- fixed test conditions ---
WPNAV_SPEED      1000
WPNAV_SPEED_UP   250
WPNAV_SPEED_DN   150
WPNAV_ACCEL      250
WP_YAW_BEHAVIOR  0
AUTO_OPTIONS     3
SIM_WIND_SPD     0
SIM_WIND_TURB    0

# battery failsafes off so a failsafe LAND can't cut a test short
BATT_FS_LOW_ACT  0
BATT_FS_CRT_ACT  0

# no terrain data in SITL; avoids terrain errors in the log
TERRAIN_ENABLE   0

# --- logging: only what analyze.py uses ---
# The Windows SITL build writes logs slowly; full-rate logging drops most
# messages. Bits: ATT_FAST(0) GPS(2) PM(3) CTUN(4) CMD(8) CURRENT(9) RCOUT(10).
# ANG/RATE are capped at 50 Hz. Check log_dropped == 0 in results.
LOG_BITMASK      1821
LOG_FILE_RATEMAX 50
EK3_LOG_LEVEL    3
SIM_ESC_TELEM    0
LOG_DISARMED     0
